pipeline {
    agent any

    environment {
        TEST_DIR = 'EcuBench/automation'    // folder that contains the .robot files
    }

    stages {
        stage('Setup') {
            steps {
                dir("${TEST_DIR}") {
                    sh '''
                        python3 -m venv venv
                        venv/bin/python -m pip install robotframework
                    '''
                }
            }
        }
        stage('Test') {
            steps {
                dir("${TEST_DIR}") {
                    sh '''
                        venv/bin/python -m robot --outputdir results ecu_voltage_alone.robot ecu_can_flags.robot
                    '''
                }
            }
        }
    }

    post {
        always {
            robot outputPath: "${TEST_DIR}/results"
            archiveArtifacts artifacts: "${TEST_DIR}/results/*", allowEmptyArchive: true
        }
    }
}
